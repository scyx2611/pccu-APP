{
  "name": "pccu-app",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.4 <21",
    "npm": ">=10.8.2 <11"
  },
  "packageManager": "npm@10.8.2",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "verify:pccu-login": "node scripts/verify-pccu-login.cjs",
    "eas": "eas",
    "build:ios:development": "eas build -p ios --profile development",
    "build:ios:preview": "eas build -p ios --profile preview",
    "build:ios:production": "eas build -p ios --profile production",
    "submit:ios:production": "eas submit -p ios --profile production",
    "lint": "eslint app src scripts --max-warnings=0",
    "lint:boundaries": "eslint \"src/core/**/*.{ts,tsx}\" \"src/features/*/{domain,application,infrastructure,state,presentation}/**/*.{ts,tsx}\" --no-error-on-unmatched-pattern --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "coverage:ci": "jest --runInBand --coverage",
    "typecheck": "tsc --noEmit",
    "export:smoke": "expo export --platform ios --output-dir .expo-export-smoke",
    "audit:prod": "npm audit --omit=dev --audit-level=critical",
    "verify": "npm run lint && npm run lint:boundaries && npm run format:check && npm run typecheck && npm run coverage:ci && npm run export:smoke"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "axios": "^1.13.6",
    "buffer": "^6.0.3",
    "cheerio": "^1.0.0-rc.12",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.12",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "iconv-lite": "^0.7.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "^13.15.0",
    "string_decoder": "^1.3.0",
    "zustand": "^5.0.12"
  },
  "overrides": {
    "shell-quote": "1.8.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eas-cli": "^18.4.0",
    "eslint": "^9.38.0",
    "eslint-config-expo": "^10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "playwright": "^1.59.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
