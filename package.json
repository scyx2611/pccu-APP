{
  "name": "pccu-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "verify:pccu-login": "node scripts/verify-pccu-login.cjs",
    "eas": "eas",
    "build:ios:development": "eas build -p ios --profile development",
    "build:ios:preview": "eas build -p ios --profile preview",
    "build:ios:production": "eas build -p ios --profile production",
    "submit:ios:production": "eas submit -p ios --profile production",
    "test": "jest",
    "test:ci": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:ci"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.5",
    "axios": "^1.13.6",
    "buffer": "^6.0.3",
    "cheerio": "^1.0.0-rc.12",
    "expo": "~54.0.0",
    "expo-asset": "~12.0.12",
    "expo-blur": "~15.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "iconv-lite": "^0.7.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "^13.15.0",
    "string_decoder": "^1.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "eas-cli": "^18.4.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.0",
    "playwright": "^1.59.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
